<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar: Next turn and Sort as icons, the rest in the overflow menu -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Hidden while the Edit Order screen is open -->
    <group android:id="@+id/group_encounter">
        <item
            android:id="@+id/action_settings_next_turn"
            android:icon="@drawable/ic_skip_next"
            android:orderInCategory="1"
            android:title="@string/action_next_turn"
            app:showAsAction="always" />
        <item
            android:id="@+id/action_settings_sort"
            android:icon="@drawable/ic_sort"
            android:orderInCategory="2"
            android:title="@string/action_sort"
            app:showAsAction="always" />
        <item
            android:id="@+id/action_settings_add_character"
            android:orderInCategory="3"
            android:title="@string/action_add_character"
            app:showAsAction="never" />
        <item
            android:id="@+id/action_settings_delete_character"
            android:orderInCategory="4"
            android:title="@string/action_delete_character"
            app:showAsAction="never" />
        <item
            android:id="@+id/action_settings_set_pcs_max_hp"
            android:orderInCategory="5"
            android:title="@string/action_set_pcs_max_hp"
            app:showAsAction="never" />
    </group>

    <item
        android:id="@+id/action_settings_about"
        android:orderInCategory="6"
        android:title="@string/action_about"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_settings_privacy"
        android:orderInCategory="7"
        android:title="@string/action_privacy"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_settings_tip"
        android:orderInCategory="8"
        android:title="@string/action_tip"
        app:showAsAction="never" />

</menu>
