<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar: PCs to max HP and Sort, only on the encounter. Next turn and the round are in the
     turn bar under the encounter; Add, Delete and Edit order are in the navigation drawer. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Only shown on the encounter -->
    <group android:id="@+id/group_encounter">
        <item
            android:id="@+id/action_pcs_max_hp"
            android:icon="@drawable/ic_heal"
            android:orderInCategory="1"
            android:title="@string/action_pcs_max_hp_short"
            app:showAsAction="always" />
        <item
            android:id="@+id/action_settings_sort"
            android:icon="@drawable/ic_sort"
            android:orderInCategory="2"
            android:title="@string/action_sort"
            app:showAsAction="always" />
    </group>

</menu>
