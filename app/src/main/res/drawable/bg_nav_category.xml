<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer category background: a 1dp divider line at the top, inset 16dp on both sides.
     Separates each group from the one above it, like the design. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="top"
        android:height="1dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</layer-list>