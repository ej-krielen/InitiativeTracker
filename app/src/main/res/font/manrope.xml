<?xml version="1.0" encoding="utf-8"?>
<!-- Manrope: UI text and numbers. Android picks the file that matches the requested
     weight, e.g. android:textStyle="bold" uses manrope_bold (700). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/manrope_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/manrope_medium" android:fontStyle="normal" android:fontWeight="500" />
    <font android:font="@font/manrope_semibold" android:fontStyle="normal" android:fontWeight="600" />
    <font android:font="@font/manrope_bold" android:fontStyle="normal" android:fontWeight="700" />
    <font android:font="@font/manrope_extrabold" android:fontStyle="normal" android:fontWeight="800" />
</font-family>
