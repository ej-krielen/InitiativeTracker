<?xml version="1.0" encoding="utf-8"?>
<!-- Edit Order: a short instruction, then the characters with up and down buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="@dimen/space_3"
        android:text="@string/edit_order_instruction"
        android:textAppearance="@style/TextAppearance.Rekijan.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/edit_order_recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="@dimen/space_3" />
</LinearLayout>
