<?xml version="1.0" encoding="utf-8"?>
<!--
    Main screen: toolbar, one pane (the encounter, or the details / Edit Order in its place)
    and the ad bar.
    layout-land puts the details next to the list. Edge-to-edge: MainActivity pads the root for
    the status bar, navigation bar and keyboard, so nothing here uses fitsSystemWindows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:title="@string/app_name"
        app:titleTextColor="@color/rk_wordmark" />

    <FrameLayout
        android:id="@+id/main_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Ad bar: stays GONE (zero height) until an ad has loaded, and for Remove Ads owners -->
    <nl.rekijan.ads.RekijanBannerAdView
        android:id="@+id/bottomAdBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:visibility="gone" />
</LinearLayout>
