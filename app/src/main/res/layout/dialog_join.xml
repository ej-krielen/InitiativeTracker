<?xml version="1.0" encoding="utf-8"?>
<!-- The GM's popup for a new player when the party has PCs they could be linked to: who wants to
     join, then one choice per PC to link to and "Add as a new PC" (added by ApprovalDialogs). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/space_4">

        <TextView
            android:id="@+id/join_message_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.Rekijan.Body"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <RadioGroup
            android:id="@+id/join_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_1"
            android:text="@string/approval_link_hint"
            android:textAppearance="@style/TextAppearance.Rekijan.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
