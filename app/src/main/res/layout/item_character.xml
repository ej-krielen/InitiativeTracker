<?xml version="1.0" encoding="utf-8"?>
<!-- One character in the initiative order: a PC (gold) or NPC (bordeaux) tinted card with a marker
     stripe, the initiative and name (editable in place), the hp (tap to change), a details button
     and a summary of the (de)buffs. CharacterAdapter sets the colors and the active-turn outline. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/character_cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    app:contentPadding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/character_marker_view"
            android:layout_width="@dimen/card_marker_width"
            android:layout_height="match_parent"
            tools:background="@color/rk_pc_marker" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_2"
            android:paddingBottom="@dimen/space_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout style="@style/Widget.Rekijan.StatBox">

                    <EditText
                        android:id="@+id/character_initiative_editText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="center"
                        android:hint="@string/char_card_initiative_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="numberSigned"
                        android:minHeight="32dp"
                        android:padding="0dp"
                        android:selectAllOnFocus="true"
                        android:textAppearance="@style/TextAppearance.Rekijan.StatValue"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="18" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/char_card_initiative"
                        android:textAppearance="@style/TextAppearance.Rekijan.StatLabel" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="@dimen/space_2">

                    <EditText
                        android:id="@+id/character_name_editText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="@string/EH_character_name"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName|textCapWords"
                        android:minHeight="@dimen/touch_target"
                        android:padding="0dp"
                        android:textAppearance="@style/TextAppearance.Rekijan.CardTitle"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Valeros" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/character_type_textView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Rekijan.StatLabel"
                            tools:text="@string/char_card_pc"
                            tools:textColor="@color/rk_pc_marker" />

                        <!-- Table sync: Synced or Player left, outlined in its color (CharacterAdapter) -->
                        <TextView
                            android:id="@+id/character_sync_textView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_1"
                            android:background="@drawable/bg_sync_tag"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textAppearance="@style/TextAppearance.Rekijan.StatLabel"
                            android:visibility="gone"
                            tools:backgroundTint="@color/rk_status_on"
                            tools:text="@string/char_card_synced"
                            tools:textColor="@color/rk_status_on"
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/character_hp_box"
                    style="@style/Widget.Rekijan.StatBox"
                    android:layout_width="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:minWidth="@dimen/stat_box_width"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="@dimen/space_2">

                    <TextView
                        android:id="@+id/character_hp_textView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="32dp"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.Rekijan.StatValue"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="24 / 32" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/char_card_hp"
                        android:textAppearance="@style/TextAppearance.Rekijan.StatLabel" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/show_character_detail_button"
                    style="@style/Widget.Rekijan.IconButton"
                    android:contentDescription="@string/char_card_show_more"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <TextView
                android:id="@+id/character_debuffs_textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:layout_marginEnd="@dimen/space_3"
                android:drawablePadding="@dimen/space_1"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Rekijan.M3BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_auto_awesome"
                app:drawableTint="?attr/colorSecondary"
                tools:text="Haste (3) · Bless (5)"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
