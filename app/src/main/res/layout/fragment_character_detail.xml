<?xml version="1.0" encoding="utf-8"?>
<!-- The details of one character in the GM's encounter: the name, then the sheet with the Stats
     and Conditions tabs (view_character_sheet). CharacterDetailFragment binds it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/character_detail_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="@dimen/space_1"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        tools:text="Merisiel" />

    <!-- While hosting Table sync, for a synced PC: its status and Unlink -->
    <LinearLayout
        android:id="@+id/character_sync_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_2"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/character_sync_status_textView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Rekijan.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="@string/sync_linked_synced" />

        <Button
            android:id="@+id/character_unlink_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sync_unlink" />
    </LinearLayout>

    <include
        android:id="@+id/character_sheet"
        layout="@layout/view_character_sheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
