<?xml version="1.0" encoding="utf-8"?>
<!-- One character on the Edit Order screen: move up, initiative, name, a flag on the one who is
     first in round, move down. Same PC / NPC colors as the main list (EditOrderAdapter). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/edit_order_cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    app:contentPadding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/edit_order_marker_view"
            android:layout_width="@dimen/card_marker_width"
            android:layout_height="match_parent"
            tools:background="@color/rk_pc_marker" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/up_edit_order_button"
                style="@style/Widget.Rekijan.Button.Tonal.Icon"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/edit_order_up"
                app:icon="@drawable/ic_arrow_upward" />

            <LinearLayout
                style="@style/Widget.Rekijan.StatBox"
                android:layout_marginStart="@dimen/space_2">

                <TextView
                    android:id="@+id/edit_order_initiative_textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Rekijan.StatValue"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="16" />

                <TextView
                    android:id="@+id/initiative_textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/char_card_initiative"
                    android:textAppearance="@style/TextAppearance.Rekijan.StatLabel" />
            </LinearLayout>

            <TextView
                android:id="@+id/edit_order_name_textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_marginEnd="@dimen/space_2"
                android:layout_weight="1"
                android:ellipsize="end"
                android:hint="@string/EH_character_name"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Rekijan.CardTitle"
                android:textColor="?attr/colorOnSurface"
                tools:text="Valeros" />

            <ImageView
                android:id="@+id/first_in_round_imageView"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/space_2"
                android:contentDescription="@string/edit_order_first_in_round"
                android:src="@drawable/ic_flag"
                app:tint="?attr/colorSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/down_edit_order_button"
                style="@style/Widget.Rekijan.Button.Tonal.Icon"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/edit_order_down"
                app:icon="@drawable/ic_arrow_downward" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
