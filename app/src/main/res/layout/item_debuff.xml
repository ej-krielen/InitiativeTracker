<?xml version="1.0" encoding="utf-8"?>
<!-- One (de)buff on the character details: name, duration in rounds, remove, and a description.
     DebuffAdapter binds it. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/debuff_cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    app:contentPaddingBottom="@dimen/space_3"
    app:contentPaddingEnd="@dimen/space_1"
    app:contentPaddingStart="@dimen/space_3"
    app:contentPaddingTop="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Rekijan.TextInputLayout.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/debuff_card_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/debuff_name_editText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Rekijan.TextInputLayout.Outlined"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:hint="@string/debuff_card_duration_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/debuff_duration_editText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:selectAllOnFocus="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/remove_debuff_button"
                style="@style/Widget.Rekijan.IconButton"
                android:contentDescription="@string/debuff_card_remove_button"
                android:src="@drawable/ic_delete" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rekijan.TextInputLayout.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_3"
            android:hint="@string/debuff_card_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/debuff_description_editText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Only for a spell: who cast it, and (GM only) ending it on every target -->
        <LinearLayout
            android:id="@+id/debuff_spell_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginEnd="@dimen/space_3"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/debuff_caster_textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="@dimen/space_1"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Rekijan.M3BodySmall"
                android:textColor="?attr/colorSecondary"
                app:drawableStartCompat="@drawable/ic_spellbook"
                app:drawableTint="?attr/colorSecondary"
                tools:text="Cast by Mira" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debuff_end_all_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debuff_end_all" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
