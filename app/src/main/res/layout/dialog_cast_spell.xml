<?xml version="1.0" encoding="utf-8"?>
<!-- Cast spell: the caster (the active character unless changed), the spell's name, duration in
     rounds (empty for no timer) and description, and the targets as checkboxes. SpellDialogs
     fills the caster list and the targets, and shows the errors. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/space_4">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/spell_caster_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/spell_caster">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/spell_caster_dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/spell_name_layout"
                style="@style/Widget.Rekijan.TextInputLayout.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/spell_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/spell_name_editText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:maxLength="100"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/spell_duration_layout"
                style="@style/Widget.Rekijan.TextInputLayout.Outlined"
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:hint="@string/spell_duration">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/spell_duration_editText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rekijan.TextInputLayout.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:hint="@string/spell_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/spell_description_editText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/spell_targets"
            android:textAppearance="@style/TextAppearance.Rekijan.StatLabel"
            android:textColor="?attr/colorSecondary" />

        <TextView
            android:id="@+id/spell_targets_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spell_error_targets"
            android:textAppearance="@style/TextAppearance.Rekijan.M3BodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/spell_targets_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
